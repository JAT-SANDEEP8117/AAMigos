# Server environment variables
# Copy this file to .env and fill in your real values.

# Required: MongoDB Atlas or local MongoDB connection string
MONGO_URI=

# Required: secret key for JWT signing. Use a long random value.
JWT_SECRET=

# Optional: server port. Defaults to 5000 when omitted.
PORT=5000

# Required while using Cloudinary-backed profile picture and invoice uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required for the AAMigos chatbot
GROQ_API_KEY=

# Optional: Groq model used by the chatbot. Keep this default if you only have an API key.
GROQ_MODEL=llama-3.1-8b-instant

# Required to seed the first admin account on server startup
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: display name for the seeded admin account
ADMIN_NAME=Admin
